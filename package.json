{
  "name": "serverbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:stats": "node --experimental-strip-types --test src/lib/bettingStats.test.ts",
    "test:surebet": "node --experimental-strip-types --import ./scripts/register-ts-ext.mjs --test src/lib/nearbySurebet.test.ts src/lib/executionService.test.ts",
    "test:security": "node --experimental-strip-types --import ./scripts/register-ts-ext.mjs --test src/lib/botManagerUrl.test.ts",
    "seed:surebet-templates": "node --env-file=.env.local scripts/seedSurebetTemplates.mjs",
    "seed:surebet-templates:all": "node --env-file=.env.local scripts/seedSurebetTemplates.mjs --all",
    "seed:local-client": "node --env-file=.env.local scripts/createLocalClient.mjs",
    "seed:client-accounts": "node --env-file=.env.local scripts/seedClientAccounts.mjs",
    "seed:vps-nodes": "node --env-file=.env.local scripts/seedVpsNodes.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "he": "^1.2.0",
    "mongoose": "^9.1.5",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/he": "^1.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
